PORT=3004

# The service connects with the app role (no superuser, so the RLS policies apply) and
# the Prisma CLI (migrate) with the table owner. Roles: syner/postgres-init/app-role.sh
DATABASE_URL="postgresql://finance_app:change-me@localhost:5434/financedb?schema=public"
MIGRATE_DATABASE_URL="postgresql://postgres:change-me@localhost:5434/financedb?schema=public"

RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Read-only gRPC access to the stock (products-ms) and the open purchase orders (orders-ms).
# Outside Docker they are not published to the host: run them locally too
PRODUCTS_MICROSERVICE_HOST=localhost
PRODUCTS_MICROSERVICE_PORT=3001
ORDERS_MICROSERVICE_HOST=localhost
ORDERS_MICROSERVICE_PORT=3002

# Optional (defaults shown)
# BUSINESS_TIMEZONE=America/Bogota
# OUTBOX_POLL_INTERVAL_MS=1000
